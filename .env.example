# =============================================================================
# CONFIGURACIÓN — Granite Blog Writer v3.0 (Cyber-Legal Edition)
# =============================================================================

# ── Ollama Local / Cloud ──────────────────────────────────────────────────────
# URL base del servicio Ollama.
# Local: http://localhost:11434 | Docker/Cloud: http://ollama:11434 o host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434

# Modelo principal para redacción de alta calidad (8b recomendado si tienes >= 8GB RAM)
GRANITE_MODEL=granite3.3:8b

# Modelo rápido para pruebas ágiles o equipos con < 8GB RAM (2b)
FAST_MODEL=granite3.3:2b

# ── Parámetros de Inferencia en CPU/GPU ─────────────────────────────────────────
# Máximo de tokens a generar por respuesta (3000-4096 para artículos largos)
MAX_TOKENS=4096

# Ventana de contexto para Ollama (8192 recomendado para RAG y contexto amplio)
NUM_CTX=8192

# Tiempo que el modelo permanece en memoria RAM tras la última petición
KEEP_ALIVE=30m

# Hilos de CPU asignados a la inferencia (ajústalo según tus núcleos lógicos)
NUM_THREAD=4

# Temperatura por defecto (0.15-0.3 para rigor jurídico y anti-alucinación)
TEMPERATURE=0.2

# ── Servidor FastAPI & Red ────────────────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma, o * para permitir todo)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Host de enlace (127.0.0.1 para local seguro, 0.0.0.0 para Docker/Cloud/Colab)
APP_HOST=127.0.0.1

# Puerto del servidor web
APP_PORT=8000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Jurisdicción y RAG ────────────────────────────────────────────────────────
# auto: detecta automáticamente si el contenido trata sobre Venezuela, Colombia o Internacional
# venezuela: fuerza citas exclusivas de leyes venezolanas y estándares ISO/NIST
# international: enfocado en estándares globales sin forzar leyes venezolanas
DEFAULT_JURISDICTION=auto

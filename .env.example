# Configuración del Creador de Artículos de Blog con IBM Granite
OLLAMA_BASE_URL=http://localhost:11434
GRANITE_MODEL=granite3.3:8b
FAST_MODEL=granite3.3:2b
MAX_TOKENS=4096
NUM_CTX=8192
KEEP_ALIVE=30m
NUM_THREAD=4
TEMPERATURE=0.7
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_JURISDICTION=auto

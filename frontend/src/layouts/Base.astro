---
// Layout Base Cyber-Legal Dark OLED — JullEditor
import UswdsIcon from '../components/UswdsIcon.astro';
const site = Astro.site ?? new URL('https://example.com');
export interface Props {
  title: string;
  description?: string;
  jsonLd?: object;
  activeNav?: 'studio';
  wide?: boolean;
}
const { 
  title, 
  description = 'JullEditor: Estación Editorial y Pericial de Redacción Jurídica, Ciberseguridad Forense y Artículos Científicos.', 
  jsonLd,
  activeNav,
  wide = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site).href;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header class="site-header">
      <div class="header-container">
        <a class="brand" href="/" aria-label="JullEditor - Inicio">
          <img
            src="/images/gutenberg-emblem.png"
            alt="Logo Gutenberg"
            class="brand-logo"
            width="32"
            height="32"
            loading="eager"
            decoding="async"
          />
          <span>JullEditor</span>
          <span class="brand-badge">Artículos Astro</span>
        </a>

        <nav class="header-nav" aria-label="Navegación principal">
          <a
            href="/"
            class={currentPath === '/' || currentPath === '/studio' ? 'active' : ''}
            aria-current={currentPath === '/' || currentPath === '/studio' ? 'page' : undefined}
          >Estudio Redactor</a>
          <a href="/#control-calidad">Control de calidad</a>
          <a href="/#taxonomia">Taxonomía</a>
          <a href="/rss.xml">RSS</a>
        </nav>

        <div class="header-actions">
          <a class="btn-primary" href="/">
            <UswdsIcon name="edit" />
            <span>Abrir Estudio</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class:list={['site-main', { 'site-main-wide': wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div>
          <strong>JullEditor</strong> · Estación Pericial & Editorial Libre de Fuga de Datos
          <div style="font-size: 0.75rem; color: var(--fg-dim); margin-top: 0.25rem;">
            Alineado con CRBV (Arts. 28, 60), G.O. 37.313, G.O. 37.148, ISO/IEC 27037 y Manual MP/CICPC 2017.
          </div>
        </div>
        <div class="footer-links">
          <a href="/">Estudio Redactor</a>
          <a href="/#control-calidad">Control de calidad</a>
          <a href="/#taxonomia">Taxonomía</a>
          <a href="/rss.xml">Feed RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
---
<Base
  title="Redactor local de artículos — JullEditor"
  description="Redacta artículos con el motor local, guarda el resultado y publícalo en la colección Astro."
  activeNav="writer"
>
  <section class="hero-editorial">
    <div class="kicker"><span>✍️</span><span>Motor editorial local · FastAPI + Ollama</span></div>
    <h1>Redactor de artículos</h1>
    <p class="hero-lead">
      Envía fuentes al motor local, transmite la generación en vivo y guarda o prepara
      artículos para la colección Astro. <a href="/studio">Abre el estudio de edición avanzada</a>.
    </p>
  </section>

  <section class="writer-panel" aria-labelledby="writer-heading">
    <h2 id="writer-heading">Fuente y parámetros editoriales</h2>
    <div class="writer-fields">
      <label>Título de la fuente
        <input id="source-title" class="form-input" maxlength="300" placeholder="Título del artículo" />
      </label>
      <label>URL de atribución (opcional)
        <input id="source-url" class="form-input" type="url" maxlength="2048" placeholder="https://..." />
      </label>
      <label>Tema
        <select id="theme" class="form-select">
          <option value="cybersecurity">Ciberseguridad</option>
          <option value="legal_tech">Derecho digital y LegalTech</option>
          <option value="ai_data">Inteligencia artificial y datos</option>
          <option value="science_tech">Ciencia y tecnología</option>
          <option value="sentencia_tsj">Sentencia TSJ</option>
        </select>
      </label>
      <label>Voz editorial
        <select id="tone" class="form-select">
          <option value="conversational">Conversacional ágil</option>
          <option value="analista_tsj_revista">Analista jurisprudencial TSJ</option>
          <option value="abogado_ve_doctrinal">Abogado VE doctrinal</option>
          <option value="didactic">Didáctico / pedagógico</option>
          <option value="analytical">Analítico pericial</option>
        </select>
      </label>
      <label>Extensión objetivo
        <select id="target-words" class="form-select">
          <option value="600">600 palabras</option>
          <option value="1000" selected>1000 palabras</option>
          <option value="1500">1500 palabras</option>
          <option value="2000">2000 palabras</option>
        </select>
      </label>
      <label>Instrucciones adicionales (opcional)
        <input id="instructions" class="form-input" maxlength="1000" placeholder="Indica un enfoque o requisito" />
      </label>
    </div>
    <label class="writer-source">Texto fuente
      <textarea id="source-text" class="form-textarea" rows="9" maxlength="120000"
        placeholder="Pega aquí el texto de referencia (mínimo 10 caracteres)." required></textarea>
    </label>
    <div class="writer-actions">
      <label class="btn-secondary writer-file">
        Cargar archivo .md o .json
        <input id="source-file" type="file" accept=".md,.markdown,.txt,.json" hidden />
      </label>
      <button id="generate" class="btn-primary" type="button">Generar artículo</button>
      <button id="stop" class="btn-secondary" type="button" disabled>Detener</button>
      <span id="writer-status" role="status" aria-live="polite"></span>
    </div>
  </section>

  <section class="writer-panel" aria-labelledby="result-heading">
    <div class="writer-result-heading">
      <h2 id="result-heading">Artículo generado</h2>
      <span id="word-count">0 palabras</span>
    </div>
    <textarea id="article" class="form-textarea writer-article" rows="22"
      placeholder="La generación aparecerá aquí." spellcheck="false"></textarea>
    <div class="writer-actions">
      <button id="save" class="btn-secondary" type="button" disabled>Guardar artículo</button>
      <button id="publish" class="btn-primary" type="button" disabled>Preparar para Astro</button>
    </div>
    <p class="writer-note">
      “Preparar para Astro” valida y copia el artículo a la colección. Para que las rutas
      prerenderizadas aparezcan en el sitio publicado, vuelve a ejecutar el build Astro.
    </p>
  </section>

  <style>
    .writer-panel {
      margin: 1.25rem 0;
      padding: 1.25rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-hairline);
      border-radius: 10px;
    }
    .writer-panel h2 { margin: 0 0 1rem; font-size: 1.1rem; }
    .writer-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .writer-fields label, .writer-source {
      display: grid;
      gap: .4rem;
      color: var(--fg-secondary);
      font-size: .85rem;
    }
    .writer-source { margin-top: 1rem; }
    .writer-actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; margin-top: .9rem; }
    .writer-file { cursor: pointer; }
    .writer-result-heading { display: flex; justify-content: space-between; align-items: baseline; }
    .writer-article { min-height: 28rem; font-family: var(--font-mono); }
    .writer-note { color: var(--fg-muted); font-size: .8rem; }
    #writer-status { color: var(--accent-cyan); font-size: .82rem; }
    @media (max-width: 700px) {
      .writer-fields { grid-template-columns: 1fr; }
      .writer-panel { padding: .9rem; }
    }
  </style>

  <script>
    const byId = <T extends HTMLElement>(id: string) => {
      const element = document.getElementById(id);
      if (!element) throw new Error(`Missing writer element: ${id}`);
      return element as T;
    };

    const sourceTitle = byId<HTMLInputElement>('source-title');
    const sourceUrl = byId<HTMLInputElement>('source-url');
    const sourceText = byId<HTMLTextAreaElement>('source-text');
    const article = byId<HTMLTextAreaElement>('article');
    const status = byId<HTMLElement>('writer-status');
    const generateButton = byId<HTMLButtonElement>('generate');
    const stopButton = byId<HTMLButtonElement>('stop');
    const saveButton = byId<HTMLButtonElement>('save');
    const publishButton = byId<HTMLButtonElement>('publish');
    const wordCount = byId<HTMLElement>('word-count');
    let activeController: AbortController | undefined;
    let savedSlug: string | undefined;

    const updateWordCount = () => {
      const words = article.value.trim() ? article.value.trim().split(/\s+/).length : 0;
      wordCount.textContent = `${words} palabras`;
      saveButton.disabled = words === 0;
      publishButton.disabled = words === 0;
    };

    byId<HTMLInputElement>('source-file').addEventListener('change', async (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      sourceText.value = await file.text();
      const response = await fetch('/backend-api/api/parse-docling-md', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: sourceText.value, filename: file.name }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.detail || 'No se pudo analizar el archivo.');
      sourceTitle.value = result.title || file.name.replace(/\.[^.]+$/, '');
      byId<HTMLSelectElement>('theme').value = result.detected_theme || 'cybersecurity';
      status.textContent = `Fuente cargada: ${result.word_count} palabras.`;
    });

    generateButton.addEventListener('click', async () => {
      if (sourceText.value.trim().length < 10) {
        status.textContent = 'Agrega un texto fuente de al menos 10 caracteres.';
        sourceText.focus();
        return;
      }

      activeController = new AbortController();
      generateButton.disabled = true;
      stopButton.disabled = false;
      status.textContent = 'Conectando con el motor local…';
      article.value = '';
      updateWordCount();

      try {
        const response = await fetch('/backend-api/api/generate-stream', {
          method: 'POST',
          signal: activeController.signal,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source_text: sourceText.value,
            source_title: sourceTitle.value,
            source_url: sourceUrl.value,
            theme: byId<HTMLSelectElement>('theme').value,
            tone: byId<HTMLSelectElement>('tone').value,
            target_words: Number(byId<HTMLSelectElement>('target-words').value),
            custom_instructions: byId<HTMLInputElement>('instructions').value,
            editorial_mode: 'astro_editorial',
            jurisdiction: 'venezuela',
          }),
        });
        if (!response.ok || !response.body) {
          const error = await response.json().catch(() => ({}));
          throw new Error(error.detail || `Error del motor local (${response.status}).`);
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let pending = '';
        while (true) {
          const { value, done } = await reader.read();
          pending += decoder.decode(value, { stream: !done });
          const events = pending.split('\n\n');
          pending = events.pop() || '';
          for (const event of events) {
            const dataLine = event.split('\n').find((line) => line.startsWith('data: '));
            if (!dataLine) continue;
            const data = JSON.parse(dataLine.slice(6));
            if (data.error) throw new Error(data.error);
            if (data.token) article.value += data.token;
            if (data.done) status.textContent = 'Generación completada.';
            updateWordCount();
          }
          if (done) break;
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') {
          status.textContent = 'Generación detenida.';
        } else {
          status.textContent = error instanceof Error ? error.message : 'Error generando el artículo.';
        }
      } finally {
        activeController = undefined;
        generateButton.disabled = false;
        stopButton.disabled = true;
        updateWordCount();
      }
    });

    stopButton.addEventListener('click', async () => {
      activeController?.abort();
      await fetch('/backend-api/api/stop-generation', { method: 'POST' });
    });

    saveButton.addEventListener('click', async () => {
      try {
        const response = await fetch('/backend-api/api/save-generated-article', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: sourceTitle.value || 'Artículo JullEditor',
            markdown_content: article.value,
            theme: byId<HTMLSelectElement>('theme').value,
            tone: byId<HTMLSelectElement>('tone').value,
            source_url: sourceUrl.value,
            jurisdiction: 'venezuela',
            editorial_mode: 'astro_editorial',
          }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.detail || 'No se pudo guardar el artículo.');
        savedSlug = result.astro_filename?.replace(/\.md$/, '');
        status.textContent = `Guardado: ${result.filename}.`;
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Error guardando el artículo.';
      }
    });

    publishButton.addEventListener('click', async () => {
      try {
        if (!savedSlug) {
          status.textContent = 'Guarda el artículo antes de prepararlo para Astro.';
          return;
        }
        const response = await fetch('/backend-api/api/export/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: savedSlug }),
        });
        const result = await response.json();
        if (!response.ok || result.status !== 'success') {
          throw new Error(result.message || result.detail || 'No se pudo publicar el artículo.');
        }
        status.textContent = `Artículo validado y copiado a la colección Astro (${result.action}). Ejecuta el build para regenerar las rutas.`;
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Error publicando el artículo.';
      }
    });

    article.addEventListener('input', updateWordCount);
  </script>
</Base>

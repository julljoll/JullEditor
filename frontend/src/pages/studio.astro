          const model = phiModelInput ? phiModelInput.value : 'phi3';
          chatAgentLabel.textContent = `Microsoft Phi Local (${model})`;
        }
        updateRunButtonText();
      } else {
        btnProvGemini?.classList.add('active');
        btnProvPhi?.classList.remove('active', 'phi');
        if (configPanelGemini) configPanelGemini.style.display = 'block';
        if (configPanelPhi) configPanelPhi.style.display = 'none';

        if (activeProviderPill) {
          activeProviderPill.textContent = 'GEMINI ONLINE';
          activeProviderPill.style.color = 'var(--accent-green)';
          activeProviderPill.style.background = 'var(--accent-green-dim)';
        }
        if (headerEngineBadge) {
          headerEngineBadge.textContent = 'Motor Activo: Google Gemini 3.5 Flash (Online Cloud) · sha256.us 🇻🇪';
        }
        if (chatStatusDot) {
          chatStatusDot.className = 'chat-agent-dot';
        }
        if (chatAgentLabel) {
          chatAgentLabel.textContent = 'Google Gemini 3.5 Flash (Online)';
        }
        updateRunButtonText();
      }
    }

    btnProvGemini?.addEventListener('click', () => setProvider('gemini'));
    btnProvPhi?.addEventListener('click', () => setProvider('phi'));

    apiKeyInput?.addEventListener('input', () => {
      localStorage.setItem('julleditor_gemini_api_key', apiKeyInput.value.trim());
    });
    phiEndpointInput?.addEventListener('input', () => {
      localStorage.setItem('julleditor_phi_endpoint', phiEndpointInput.value.trim());
    });
    phiModelInput?.addEventListener('change', () => {
      localStorage.setItem('julleditor_phi_model', phiModelInput.value);
      if (currentProvider === 'phi' && chatAgentLabel) {
        chatAgentLabel.textContent = `Microsoft Phi Local (${phiModelInput.value})`;
      }
    });

    // Probar conexión local con Microsoft Phi / Ollama
    btnTestPhi?.addEventListener('click', async () => {
      const endpoint = phiEndpointInput.value.trim() || 'http://localhost:11434';
      if (phiStatusMsg) {
        phiStatusMsg.style.display = 'block';
        phiStatusMsg.innerHTML = '⏳ Verificando conexión local con Ollama/Phi...';
      }

      try {
        const res = await fetch(`/backend-api/api/ai-status?endpoint=${encodeURIComponent(endpoint)}`);
        const data = await res.json();

        if (data.connected) {
          phiStatusMsg.style.color = 'var(--accent-green)';
          phiStatusMsg.innerHTML = `✅ <strong>Conexión exitosa:</strong> ${data.message}`;
          showToast('✅ Conexión con Microsoft Phi local verificada.');
        } else {
          phiStatusMsg.style.color = 'var(--accent-amber)';
          phiStatusMsg.innerHTML = `⚠️ <strong>Servidor no detectado:</strong> ${data.message}<br /><span style="font-size: 0.65rem; color: var(--fg-dim);">En tu equipo local, inicia Ollama ejecutando: <code style="color: var(--accent-cyan);">ollama run phi3</code></span>`;
          showToast('⚠️ Microsoft Phi no detectado en el puerto local.');
        }
      } catch (e) {
        phiStatusMsg.style.color = 'var(--accent-red)';
        phiStatusMsg.innerHTML = `❌ Error probando conexión local.`;
      }
    });

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 4000);
    }

    function updateRunButtonText() {
      const action = aiActionType ? aiActionType.value : 'generate';
      const engineName = currentProvider === 'phi' ? 'Microsoft Phi (Local)' : 'Gemini AI (Online)';

      if (action === 'reversion') {
        aiBtnText.textContent = `Reversionar con ${engineName}`;
      } else if (action === 'generate') {
        aiBtnText.textContent = `Redactar con ${engineName}`;
      } else if (action === 'summarize') {
        aiBtnText.textContent = `Resumir con ${engineName}`;
      } else if (action === 'transform') {
        aiBtnText.textContent = `Transformar con ${engineName}`;
      }
    }

    aiActionType?.addEventListener('change', updateRunButtonText);

    // Parser que renderiza fielmente HTML editorial y Markdown de Formato Blog -Astro.md
    function parseArticleContent(raw) {
      let body = raw;
      if (body.startsWith('---')) {
        const parts = body.split('---');
        if (parts.length >= 3) {
          body = parts.slice(2).join('---').trim();
        }
      }

      if (body.includes('editorial-container') || body.includes('<div') || body.includes('<p')) {
        return body
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\*([^*]+)\*/g, '<em>$1</em>')
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-primary-dark text-bold text-no-underline hover:underline">$1</a>');
      }

      let html = body
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/gim, '<em>$1</em>')
        .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
        .replace(/^\- (.*$)/gim, '<li>$1</li>')
        .replace(/\n\n+/g, '</p><p>');

      return `<p>${html}</p>`;
    }

    // Auditoría Integral Formato sha256.us
    function runAudits() {
      const text = markdownSource.value || '';
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      wordCountSpan.textContent = words.toString();
      const readMins = Math.max(1, Math.round(words / 200));
      readingTimeSpan.textContent = readMins.toString();

      const parsedHtml = parseArticleContent(text);
      renderedMagazine.innerHTML = parsedHtml;
      renderedCms.innerHTML = parsedHtml;

      // 1. Auditoría SEO & Formato Astro (sha256.us)
      let seoPassedCount = 0;
      const title = titleInput.value.trim();
      const titleLen = title.length;
      const isTitleValid = titleLen >= 40 && titleLen <= 75;
      updateCheck('check-h1', isTitleValid);
      if (isTitleValid) seoPassedCount++;

      const hasMetaDesc = /description:\s*["'][^"']{100,200}["']/.test(text) || /description:\s*["'][^"']+["']/.test(text);
      updateCheck('check-desc', hasMetaDesc);
      if (hasMetaDesc) seoPassedCount++;

      const has3ColFormat = /editorial-three-columns|editorial-col|<h2[\s>]|## /i.test(text);
      updateCheck('check-h2', has3ColFormat);
      if (has3ColFormat) seoPassedCount++;

      // Validación matemática de relleno de 3 columnas (cero espacios vacíos)
      const colMatch = text.match(/<div class="editorial-three-columns">([\s\S]*?)<\/div>\s*<!-- FIN/i) || text.match(/<div class="editorial-three-columns">([\s\S]*?)<\/div>/i);
      const colText = colMatch ? colMatch[1].replace(/<[^>]+>/g, '').trim() : '';
      const isDensityValid = words >= 1100 || colText.length >= 6500 || text.length >= 8800;
      updateCheck('check-density', isDensityValid);
      if (isDensityValid) seoPassedCount++;

      const hasFaq = /Preguntas Frecuentes|FAQ|#faq|editorial-box/i.test(text);
      updateCheck('check-faq', hasFaq);
      if (hasFaq) seoPassedCount++;

      const hasFrontmatter = text.startsWith('---') && /author:|pubDate:|tags:/.test(text);
      updateCheck('check-schema', hasFrontmatter);
      if (hasFrontmatter) seoPassedCount++;

      const seoScore = Math.round((seoPassedCount / 6) * 100);
      scoreSeoText.textContent = `${seoScore}%`;
      barSeo.style.width = `${seoScore}%`;
      barSeo.style.background = seoScore >= 80 ? 'var(--accent-green)' : (seoScore >= 50 ? 'var(--accent-amber)' : 'var(--accent-red)');

      // 2. Auditoría Jurídica & GEO 2026
      let geoPassedCount = 0;
      const hasAnswerFirst = /editorial-lead|En síntesis|En resumen|Como perito|La cadena|El combate|La preservación/.test(text);
      updateCheck('check-answer-first', hasAnswerFirst);
      if (hasAnswerFirst) geoPassedCount++;

      // Validación de negritas en palabras clave a lo largo del texto
      const strongCount = (text.match(/<strong>/gi) || []).length;
      const mdBoldCount = (text.match(/\*\*[^*]+\*\*/g) || []).length;
      const totalBolds = strongCount + mdBoldCount;
      const isBoldsValid = totalBolds >= 8;
      updateCheck('check-bolds', isBoldsValid);
      if (isBoldsValid) geoPassedCount++;

      const hasDisclaimerOrAuthor = /editorial-author-box|sha256\.us|Descargo ético|no sustituye la asesoría|fines informativos/i.test(text);
      updateCheck('check-disclaimer', hasDisclaimerOrAuthor);
      if (hasDisclaimerOrAuthor) geoPassedCount++;

      const hasNorms = /CRBV|Constitución|Gaceta Oficial|G\.O\.|37\.313|37\.148|40\.274|COPP|Infogobierno/i.test(text);
      updateCheck('check-norm', hasNorms);
      if (hasNorms) geoPassedCount++;

      const hasStandards = /cadena de custodia|SHA-256|ISO|27037|RFC 3227|mismidad|forense/i.test(text);
      updateCheck('check-standards', hasStandards);
      if (hasStandards) geoPassedCount++;

      const hasNoHype = !/garantía 100%|infallible|gana siempre|solución mágica/i.test(text);
      updateCheck('check-anti-slop', hasNoHype);
      if (hasNoHype) geoPassedCount++;

      const geoScore = Math.round((geoPassedCount / 6) * 100);
      scoreGeoText.textContent = `${geoScore}%`;
      barGeo.style.width = `${geoScore}%`;
      barGeo.style.background = geoScore >= 80 ? 'var(--accent-green)' : (geoScore >= 50 ? 'var(--accent-amber)' : 'var(--accent-red)');
    }

    function updateCheck(elementId, passed) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const icon = el.querySelector('.audit-icon');
      if (icon) {
        icon.className = `audit-icon ${passed ? 'pass' : 'fail'}`;
        icon.textContent = passed ? '✓' : '✗';
      }
    }

    function loadPreset(key) {
      const preset = PRESETS[key] || PRESETS.forensic_tsj;
      titleInput.value = preset.title;
      keywordInput.value = preset.keyword;
      categorySelect.value = preset.category;
      authorInput.value = preset.author;
      markdownSource.value = preset.content;
      runAudits();
    }

    // EJECUCIÓN PRINCIPAL DE GENERACIÓN / REVERSIÓN IA
    btnRunAi?.addEventListener('click', async () => {
      const action = aiActionType.value;
      const sourceUrl = urlInput.value.trim();
      const currentText = markdownSource.value.trim();
      const title = titleInput.value.trim();

      if (action === 'reversion' && !sourceUrl && !currentText) {
        showToast('⚠️ Pega el enlace URL del artículo que deseas reversionar.');
        urlInput.focus();
        return;
      }

      btnRunAi.disabled = true;
      aiStatusIndicator.style.display = 'block';
      const engineName = currentProvider === 'phi' ? 'Microsoft Phi (Local)' : 'Gemini AI (Online)';
      aiStatusText.textContent = sourceUrl 
        ? `Extrayendo URL y reversionando con ${engineName}...` 
        : `Generando artículo en Formato sha256.us con ${engineName}...`;

      try {
        const payload = {
          action,
          provider: currentProvider,
          source_url: sourceUrl,
          source_text: currentText,
          title,
          theme: categorySelect.value,
          tone: toneSelect.value,
          target_words: 1500,
          api_key: apiKeyInput ? apiKeyInput.value.trim() : undefined,
          local_endpoint: phiEndpointInput ? phiEndpointInput.value.trim() : 'http://localhost:11434',
          phi_model: phiModelInput ? phiModelInput.value : 'phi3',
        };

        const res = await fetch('/backend-api/api/ai-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (!res.ok || data.error) {
          throw new Error(data.error || 'Ocurrió un error al procesar con la IA.');
        }

        if (data.content) {
          markdownSource.value = data.content;
        }
        if (data.title) {
          titleInput.value = data.title;
        }
        if (data.seoKeyword) {
          keywordInput.value = data.seoKeyword;
        }
        if (data.category) {
          categorySelect.value = data.category;
        }

        runAudits();
        showToast(`✨ ¡Artículo generado con éxito en Formato Blog -Astro.md por ${data.provider === 'phi' ? 'Microsoft Phi' : 'Gemini'}!`);
        
        // Cambiar a la vista revista para apreciar el diseño de 3 columnas
        tabBtns.forEach(b => b.classList.remove('active'));
        document.querySelector('[data-tab="magazine"]')?.classList.add('active');
        tabMagazine.style.display = 'block';
        tabEditor.style.display = 'none';
        tabChat.style.display = 'none';
        tabCms.style.display = 'none';

      } catch (err) {
        console.error('Error con IA:', err);
        showToast(`❌ Error: ${err.message}`);
      } finally {
        btnRunAi.disabled = false;
        aiStatusIndicator.style.display = 'none';
      }
    });

    // SISTEMA DE CHAT INTERACTIVO CON EL AGENTE IA
    async function sendChatMessage(promptText) {
      const text = promptText || (chatUserInput ? chatUserInput.value.trim() : '');
      if (!text) return;

      if (chatUserInput) chatUserInput.value = '';

      // Agregar mensaje del usuario a la interfaz
      appendChatBubble('user', text);
      chatMessages.push({ role: 'user', content: text });
      updateChatCount();

      // Indicador de escritura
      const loadingBubble = appendChatBubble('agent', '<em>Pensando y analizando con el marco pericial...</em>', true);

      btnSendChat.disabled = true;
      chatBtnText.textContent = '...';

      try {
        const payload = {
          messages: chatMessages,
          instruction: text,
          current_article: markdownSource.value,
          provider: currentProvider,
          api_key: apiKeyInput ? apiKeyInput.value.trim() : undefined,
          local_endpoint: phiEndpointInput ? phiEndpointInput.value.trim() : 'http://localhost:11434',
          phi_model: phiModelInput ? phiModelInput.value : 'phi3',
        };

        const res = await fetch('/backend-api/api/ai-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        // Remover burbuja temporal de carga
        loadingBubble.remove();

        if (!res.ok || data.error) {
          throw new Error(data.error || 'Error en la respuesta del agente de IA.');
        }

        const replyText = data.reply || '';
        chatMessages.push({ role: 'assistant', content: replyText });
        updateChatCount();

        // Agregar burbuja del agente con soporte para aplicar cambios al artículo
        appendChatBubble('agent', replyText, false, data.updatedArticle);

      } catch (err) {
        loadingBubble.remove();
        appendChatBubble('agent', `❌ <strong>Error:</strong> ${err.message}`);
      } finally {
        btnSendChat.disabled = false;
        chatBtnText.textContent = 'Enviar';
        chatStream.scrollTop = chatStream.scrollHeight;
      }
    }

    function appendChatBubble(role, htmlOrText, isLoading = false, updatedArticle = null) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `chat-msg ${role}`;

      const bubbleDiv = document.createElement('div');
      bubbleDiv.className = `chat-bubble ${role}`;

      if (role === 'agent' && !isLoading) {
        // Formatear código en markdown simple
        let formatted = htmlOrText
          .replace(/```(?:markdown|md)?\s*\n([\s\S]*?)\n```/gi, '<pre><code>$1</code></pre>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\*([^*]+)\*/g, '<em>$1</em>')
          .replace(/\n/g, '<br />');

        bubbleDiv.innerHTML = formatted;

        // Si incluye artículo actualizado, ofrecer botón de aplicar
        if (updatedArticle) {
          const applyBtn = document.createElement('button');
          applyBtn.className = 'btn-apply-update';
          applyBtn.innerHTML = '✨ Aplicar Cambios al Artículo en el Editor';
          applyBtn.addEventListener('click', () => {
            markdownSource.value = updatedArticle;
            runAudits();
            showToast('✅ ¡Artículo actualizado en el editor con las mejoras del agente!');
            // Mostrar pestaña de revista
            tabBtns.forEach(b => b.classList.remove('active'));
            document.querySelector('[data-tab="magazine"]')?.classList.add('active');
            tabMagazine.style.display = 'block';
            tabEditor.style.display = 'none';
            tabChat.style.display = 'none';
            tabCms.style.display = 'none';
          });
          bubbleDiv.appendChild(applyBtn);
        }
      } else {
        bubbleDiv.innerHTML = htmlOrText;
      }

      const metaDiv = document.createElement('div');
      metaDiv.className = 'chat-meta';
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      metaDiv.textContent = role === 'user' ? `Tú · ${timeStr}` : `${currentProvider === 'phi' ? 'Microsoft Phi' : 'Gemini'} · ${timeStr}`;

      msgDiv.appendChild(bubbleDiv);
      msgDiv.appendChild(metaDiv);
      chatStream.appendChild(msgDiv);
      chatStream.scrollTop = chatStream.scrollHeight;

      return msgDiv;
    }

    function updateChatCount() {
      if (!chatCountBadge) return;
      if (chatMessages.length > 0) {
        chatCountBadge.style.display = 'inline-block';
        chatCountBadge.textContent = chatMessages.length.toString();
      } else {
        chatCountBadge.style.display = 'none';
      }
    }

    btnSendChat?.addEventListener('click', () => sendChatMessage());
    chatUserInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendChatMessage();
      }
    });

    btnClearChat?.addEventListener('click', () => {
      chatMessages = [];
      chatStream.innerHTML = `
        <div class="chat-msg agent">
          <div class="chat-bubble agent">
            <strong>⚖️ Copiloto Pericial sha256.us:</strong><br />
            Conversación reiniciada. Puedes solicitar ajustes de doctrina, cita de artículos o refinamiento estilístico en cualquier momento.
          </div>
          <div class="chat-meta">Agente Activo · sha256.us</div>
        </div>
      `;
      updateChatCount();
      showToast('🗑️ Historial de chat limpiado.');
    });

    // Chips de sugerencia rápida
    document.querySelectorAll('.quick-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const prompt = chip.getAttribute('data-prompt');
        if (prompt) {
          sendChatMessage(prompt);
        }
      });
    });

    // Listeners y Presets
    document.getElementById('btn-apply-preset')?.addEventListener('click', () => {
      loadPreset(presetSelector.value);
      showToast('⚡ Plantilla pericial cargada con éxito.');
    });

    document.getElementById('btn-reset-studio')?.addEventListener('click', () => {
      loadPreset('empty');
      urlInput.value = '';
      showToast('🔄 Editor restablecido.');
    });

    markdownSource.addEventListener('input', runAudits);
    titleInput.addEventListener('input', runAudits);

    // Conmutador de Pestañas
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const tab = btn.getAttribute('data-tab');

        tabMagazine.style.display = tab === 'magazine' ? 'block' : 'none';
        tabEditor.style.display = tab === 'editor' ? 'block' : 'none';
        tabChat.style.display = tab === 'chat' ? 'block' : 'none';
        tabCms.style.display = tab === 'cms' ? 'block' : 'none';

        if (tab === 'chat') {
          chatStream.scrollTop = chatStream.scrollHeight;
          chatUserInput?.focus();
        }
      });
    });

    // Copiar al Portapapeles
    document.getElementById('btn-copy-md')?.addEventListener('click', () => {
      navigator.clipboard.writeText(markdownSource.value).then(() => {
        showToast('📋 Markdown con Frontmatter copiado al portapapeles.');
      });
    });

    document.getElementById('btn-copy-html')?.addEventListener('click', () => {
      navigator.clipboard.writeText(renderedMagazine.innerHTML).then(() => {
        showToast('🌐 Código HTML CMS copiado al portapapeles.');
      });
    });

    // Descargar Archivo .md
    document.getElementById('btn-download-md')?.addEventListener('click', () => {
      const content = markdownSource.value;
      const slugMatch = content.match(/slug:\s*["']?([a-z0-9\-]+)["']?/i);
      const filename = slugMatch ? `${slugMatch[1]}.md` : 'articulo-sha256.md';
      
      const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`💾 Archivo ${filename} descargado.`);
    });

    // Cargar plantilla inicial al montar
    loadPreset('forensic_tsj');
  </script>

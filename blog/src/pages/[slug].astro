---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.draft);
  return articles.map((a) => ({
    params: { slug: a.data.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(`/${article.data.slug}`, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: article.data.author },
  keywords: article.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---
<Base title={`${article.data.title} — Pericial Blog`} description={article.data.description} jsonLd={jsonLd}>
  <article class="post">
    <header class="post-header">
      <h1>{article.data.title}</h1>
      <div class="meta">
        <time datetime={article.data.pubDate.toISOString()}>
          {article.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>· {article.data.author}</span>
        <span>· {article.data.readingTime} min</span>
      </div>
      <div class="tags">
        {article.data.tags.map((t) => <a class="tag" href={`/tags/${t.toLowerCase()}`}>{t}</a>)}
      </div>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</Base>
